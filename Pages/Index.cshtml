@page
@model IndexModel
@inject DiscChangerService dcs
@inject CustomDiscService customDiscService
@{
    ViewData["Title"] = "DiscChanger.NET " + DiscChangerService.Version?.ToString()??"--";
    ViewData["Description"] = "Disc Changer Management using ASP.NET Core";
}
<script src="~/lib/microsoft-signalr/signalr.min.js"></script>
<script src="~/js/discchanger.js"></script>

@{var discDisplaySize = Request.Cookies["DiscDisplaySize"] ?? "15"; }

<!-- Compact Bar (shown when navbar is hidden) -->
<div id="compact-bar" style="display: none; background: rgba(10, 10, 10, 0.95); border-bottom: 1px solid var(--apple-border); padding: 4px 8px; position: sticky; top: 0; z-index: 1050;">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
        <button class="btn btn-settings" onclick="toggleNavbar()" title="Show full controls" style="padding: 3px 6px; font-size: 11px; height: 26px;">
            <i class="fas fa-chevron-down"></i>
        </button>
        @{
            // Find the CD changer by name and use its exact control inputs
            var cdChanger = dcs.DiscChangers.FirstOrDefault(dc => dc.Name == "CD");
            if (cdChanger == null && dcs.DiscChangers.Count > 0)
            {
                // Fallback to first changer if no CD changer found
                cdChanger = dcs.DiscChangers[0];
            }
            
            if (cdChanger != null)
            {
                var cdKey = cdChanger.Key;
                <fieldset style="display: flex; gap: 4px; align-items: center; border: none; padding: 0; margin: 0;">
                    <input type="number" title="Disc Number" name="disc_number_@cdKey" min="1" max="400" id="disc_number_@cdKey" onchange="clear_title_album_chapter_track('@cdKey')" style="width: 50px; height: 26px; padding: 4px 6px; font-size: 11px; border: 1px solid var(--apple-border); border-radius: 6px; background: rgba(255,255,255,0.08); color: var(--apple-text-primary);" />
                    <input type="number" title="Title/Album Number" name="title_album_number_@cdKey" min="1" max="499" id="title_album_number_@cdKey" style="width: 45px; height: 26px; padding: 4px 6px; font-size: 11px; border: 1px solid var(--apple-border); border-radius: 6px; background: rgba(255,255,255,0.08); color: var(--apple-text-primary);" />
                    <input type="number" title="Chapter/Track Number" name="chapter_track_number_@cdKey" min="1" max="999" id="chapter_track_number_@cdKey" style="width: 45px; height: 26px; padding: 4px 6px; font-size: 11px; border: 1px solid var(--apple-border); border-radius: 6px; background: rgba(255,255,255,0.08); color: var(--apple-text-primary);" />
                    <button id="disc_direct_@cdKey" onclick="discDirect('@cdKey')" style="padding: 4px 14px; height: 26px; font-size: 11px; background: var(--apple-accent); color: white; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; line-height: 1;">Go</button>
                    <button class="btn btn-settings" onclick="selectSmartRandom()" title="Random Disc" style="padding: 3px 6px; background: var(--apple-accent); font-size: 10px; height: 24px; margin-left: 4px; min-width: auto;">
                        <i class="fas fa-random"></i>
                    </button>
                </fieldset>
            }
        }
        <a href="/fullscreen.html" target="_blank" class="btn btn-settings" title="Open fullscreen view" style="padding: 3px 6px; font-size: 11px; height: 26px; text-decoration: none;">
            <i class="fas fa-expand"></i>
        </a>
    </div>
</div>

<nav id="main-navbar" class="navbar navbar-expand-md sticky-top navbar-light bg-secondary">
    <a href="http://discchanger.net"><img class="navbar-brand" src="img/SonyDVP-CX777ES600.png" /></a>
    <div class="container" style="display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 4px 0;">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="boxed" style="gap: 4px;">
            <div>
                <button class="btn btn-settings" onclick="toggleNavbar()" title="Hide top bar" style="padding: 4px 8px;"><i class="fas fa-chevron-up"></i></button>
            </div><div>
                <button id="edit" class="btn btn-settings" onclick="toggle_config()" style="padding: 4px 8px;"><i title="Toggle access to settings" class="fas fa-cogs"></i></button>
            </div><div>
                <a href="/fullscreen.html" target="_blank" class="btn btn-settings" title="Open fullscreen view" style="padding: 4px 8px;"><i class="fas fa-expand"></i></a>
            </div><div>
                <input type="range" title="Disc Display Size (@(discDisplaySize)rem)" min="10" max="50" id="disc_display_size" onchange="change_display_size(this)" class="disc-display-size-slider" value="@discDisplaySize" style="width: 80px; height: 20px;" />
            </div>
        </div>
        
        <div style="display: flex; gap: 6px; align-items: center; flex-wrap: nowrap;">
            <div class="library-search" style="margin: 0;">
                <i class="fas fa-search" style="font-size: 12px; left: 8px;"></i>
                <input type="text" id="library-search" placeholder="Search..." oninput="searchLibrary()" style="width: 180px; padding: 4px 8px 4px 28px; font-size: 13px; height: 28px;" />
            </div>
            <button id="toggle-cds" class="btn btn-toggle" onclick="toggleCDSection()" title="Show/Hide CD Section" style="padding: 4px 10px; font-size: 12px; height: 28px;">
                <i class="fas fa-compact-disc"></i> CDs
            </button>
            <button id="toggle-movies" class="btn btn-toggle" onclick="toggleMovieSection()" title="Show/Hide Movie Section" style="padding: 4px 10px; font-size: 12px; height: 28px;">
                <i class="fas fa-film"></i> Movies
            </button>
            <button class="btn btn-settings" onclick="selectRandomCD()" title="Select Random CD" style="padding: 4px 10px; background: var(--apple-accent); font-size: 12px; height: 28px;">
                <i class="fas fa-random"></i>
            </button>
            <button class="btn btn-settings" onclick="selectRandomMovie()" title="Select Random Movie" style="padding: 4px 10px; background: var(--apple-accent); font-size: 12px; height: 28px;">
                <i class="fas fa-random"></i>
            </button>
        </div>
        <div class="navbar-collapse collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-lg-0 ml-3">
                <li class="nav-item">
                    <table class="controls-table">
                        @{
                            int discChangerCount = dcs.DiscChangers.Count;
                            for (int dci = 0; dci < discChangerCount; dci++)
                            {
                                Models.DiscChanger dc = dcs.DiscChangers[dci];
                                Models.DiscChanger.OpStatus opStatus = dc.GetOpStatus();
                                bool scanInProgress = opStatus != null;
                                string controlsDisplay = scanInProgress ? "none" : "block";
                                string scanControlsDisplay = scanInProgress ? "block" : "none";
                                string opStatusString = String.Empty;
                                if (opStatus?.DiscNumber != null)
                                {
                                    opStatusString = $"{opStatus.Op}: {opStatus.Index.Value}/{opStatus.Count.Value}, Slot: {opStatus.DiscNumber.Value}";
                                }

                                var name = dc.Name;
                                var key = dc.Key;
                                var changerType = dc.Type;
                                        <tr class="disc-changer" data-key="@key">
                                            <td class="changer-name" id="name_@key" title="Click to scroll current disc into view" onclick="scroll_into_view('@key')">@name</td>
                                            <td>
                                                <div id="controls_@key" style="display:@controlsDisplay;">
                                                    <button id="power_@key" class="btn btn-power" title="Toggle disc changer power" onclick="control('@key','power')"><i class="fas fa-power-off fa-lg"></i></button>
                                                    <button id="open_@key" class="btn" @Html.Raw(dc.SupportsCommand("open") ? "title=\"Open/Close door\"" : "title=\"Unsupported on " + changerType + ": Open/Close door\" data-disabled=\"true\"") onclick="control('@key','open')"><i class="fas fa-door-open fa-lg"></i></button>
                                                    <button id="previous_@key" class="btn" title="Previous track" onclick="control('@key','previous')"><i class="fas fa-fast-backward fa-lg"></i></button>
                                                    <button id="next_@key" class="btn" title="Next track" onclick="control('@key','next')"><i class="fas fa-fast-forward fa-lg"></i></button>
                                                    <button id="rev_scan_@key" class="btn" title="Reverse scan" onclick="control('@key','rev_scan')"><i class="fas fa-backward fa-lg"></i></button>
                                                    <button id="fwd_scan_@key" class="btn" title="Forward scan" onclick="control('@key','fwd_scan')"><i class="fas fa-forward fa-lg"></i></button>
                                                    <button id="play_@key" class="btn" title="Play" onclick="control('@key','play')"><i class="far fa-play-circle fa-lg"></i></button>
                                                    <button id="pause_@key" class="btn" title="Pause" onclick="control('@key','pause')"><i class="far fa-pause-circle fa-lg"></i></button>
                                                    <button id="stop_@key" class="btn" title="Stop" onclick="control('@key','stop')"><i class="far fa-stop-circle fa-lg"></i></button>
                                                    <button id="time_text_@key" class="btn" title="Time/Text" onclick="control('@key','time_text')"><i class="fas fa-remove-format fa-lg"></i></button>
                                                    <button id="discs_@key" class="btn" title="Toggle all discs vs. one disc" onclick="control('@key','discs')"><i class="fas fa-compact-disc fa-lg"></i></button>
                                                    <button id="scan_@key" class="btn" title="Prompt to start scanning given set of discs" onclick="scan('@key',&quot;@name&quot;)"><i class="fas fa-coins fa-lg"></i></button>
                                                    <button id="delete-discs_@key" class="btn" title="Prompt for set of discs to delete" onclick="deleteDiscs('@key',&quot;@name&quot;)"><i class="fas fa-minus-circle fa-lg"></i></button>
                                                    <button id="metadata_@key" class="btn" data-bs-toggle="modal" data-bs-target="#metaDataModal" data-changer-key='@key' data-changer-name="@name" title="Prompt for set of slots to retrieve metadata for"><i class="fas fa-eye fa-lg"></i></button>
                                                </div>
                                                <div id="scan-controls_@key" style="display:@scanControlsDisplay;">
                                                    <input readonly title="Status" id="scan-status_@key" size="40" value="@opStatusString" />
                                                    <button id="cancel-scan_@key" onclick="cancelOp('@key')">Cancel Operation</button>
                                                </div>
                                            </td>
                                            <td class="hide-on-config" @(name == "CD" ? "style=\"display:none;\"" : "")>
                                                <fieldset>
                                                    <input type="number" title="Disc Number" name="disc_number_@key" min="1" max="400" id="disc_number_@key" onchange="clear_title_album_chapter_track('@key')" />
                                                    <input type="number" title="Title/Album Number" name="title_album_number_@key" min="1" max="499" id="title_album_number_@key" />
                                                    <input type="number" title="Chapter/Track Number" name="chapter_track_number_@key" min="1" max="999" id="chapter_track_number_@key" />
                                                    <button id="disc_direct_@key" onclick="discDirect('@key')">Go</button>
                                                </fieldset>
                                            </td>
                                            <td hidden class="config">
                                                <a hidden asp-page="DiscChangerConfig" asp-route-key="@key" title="Go to changer config page" class="config"><button id="edit_@key" class="btn config" type="button"><i class="fas fa-cog fa-lg"></i></button></a>
                                                <a hidden asp-page="AddCustomDisc" asp-route-changerKey="@key" title="Add a custom disc" class="config"><button class="btn config" type="button"><i class="fas fa-plus fa-lg"></i> Add disc</button></a>
                                                <button id="shift_discs_@key" class="btn config" type="button" title="Shift a set of discs to new position" onclick="return shiftDiscs('@key',&quot;@name&quot;)"><i class="fas fa-dolly fa-lg"></i></button>
                                                <button id="delete_@key" class="btn config" type="button" title="Delete disc changer" onclick="return deleteChanger('@key',&quot;@name&quot;)"><i class="fas fa-trash-alt fa-lg"></i></button>
                                                @if (dci > 0)
                                        {
                                                    <button id="up_@key" class="btn config" type="button" title="Move changer up one position" onclick="moveChanger(&quot;@key&quot;,-1)"><i class="fas fa-sort-up fa-lg"></i></button>
                                        }
                                                @if (dci < discChangerCount - 1)
                                        {
                                                    <button id="down_@key" class="btn config" type="button" title="Move changer down one position" onclick="moveChanger(&quot;@key&quot;,1)"><i class="fas fa-sort-down fa-lg"></i></button>
                                        }
                                            </td>
                                        </tr>

                            }
                        }
                        <tr hidden class="config disc-changer">
                            <td>
                                <a asp-page="DiscChangerConfig"><button class="btn config" type="button" title="Add a disc changer">Add</button></a>
                                <a asp-page="GD3Config"><button class="btn config" type="button" title="Configure GetDigitalData (GD3)">GD3</button></a>
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                        </tr>
                    </table>
                </li>
            </ul>
        </div>
    </div>
</nav>
<div style="padding: 32px; padding-bottom: 0;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <div>
            <h1 id="library-title" style="font-size: 48px; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 8px; background: linear-gradient(135deg, #FFFFFF 0%, #98989D 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; cursor: pointer;" onclick="editLibraryName()" title="Click to edit library name">Your Library</h1>
            <input id="library-title-input" type="text" style="display: none; font-size: 48px; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 8px; background: transparent; color: white; border: none; border-bottom: 2px solid var(--apple-accent); outline: none; width: 100%;" onblur="saveLibraryName()" onkeypress="if(event.key==='Enter')saveLibraryName()" />
            @{
                var changerStats = new System.Text.StringBuilder();
                for (int dci = 0; dci < discChangerCount; dci++)
                {
                    Models.DiscChanger dc = dcs.DiscChangers[dci];
                    var key = dc.Key;
                    var customDiscs = customDiscService.GetCustomDiscsForChanger(key);
                    var scannedCount = dc.Discs?.Count ?? 0;
                    var customCount = customDiscs.Count();
                    var totalCount = new HashSet<string>(dc.Discs?.Keys ?? new string[0]).Union(customDiscs.Select(cd => cd.Slot)).Count();
                    changerStats.Append($"{dc.Name}: {totalCount} disc{(totalCount != 1 ? "s" : "")}");
                    if (dci < discChangerCount - 1) changerStats.Append(" • ");
                }
            }
            <p style="font-size: 17px; color: var(--apple-text-secondary); font-weight: 500; letter-spacing: -0.01em;">@Html.Raw(changerStats.ToString())</p>
        </div>
    </div>
</div>
<div class="discs" id="discs-table" style="grid-template-columns:repeat(auto-fill,minmax(@(discDisplaySize)rem,1fr))">
    @{
        for (int dci = 0; dci < discChangerCount; dci++)
        {
            Models.DiscChanger dc = dcs.DiscChangers[dci];
            var key = dc.Key;
            var changerName = dc.Name;
            Models.DiscChanger.Status status = dc.CurrentStatus();
                    <script>updateControls('@key', @(status?.discNumber?.ToString()??"null"), @(status?.titleAlbumNumber?.ToString() ?? "null"), @(status?.chapterTrackNumber?.ToString() ?? "null"), '@(status?.statusString??"off")', '@(status?.modeDisc)');</script>
            
            // Get custom discs for this changer
            var customDiscs = customDiscService.GetCustomDiscsForChanger(key).ToDictionary(cd => cd.Slot);
            
            // Merge all slots (scanned and custom) and sort them
            var allSlots = new HashSet<string>();
            var discs = dc.Discs;
            if (discs != null)
            {
                lock (discs)
                {
                    foreach (var slot in discs.Keys)
                    {
                        allSlots.Add(slot);
                    }
                }
            }
            foreach (var slot in customDiscs.Keys)
            {
                allSlots.Add(slot);
            }
            
            // Sort all slots numerically
            var sortedSlots = allSlots.OrderBy(slot => int.TryParse(slot, out int s) ? s : 0).ToList();
            
            // Render discs in sorted order
            foreach (var slot in sortedSlots)
            {
                // Custom disc overrides scanned disc if both exist
                if (customDiscs.ContainsKey(slot))
                {
                    @Html.Raw(customDiscs[slot].ToHtml(changerName));
                }
                else if (discs != null && discs.ContainsKey(slot))
                {
                    @Html.Raw(discs[slot].ToHtml());
                }
            }
        }
    }
</div>
<div class="modal fade" id="metaDataModal" tabindex="-1" role="dialog" aria-labelledby="metaDataModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="metaDataModalLabel">Retrieve metadata</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <select id="metadata-selection" selectedIndex="-1">
                        @foreach (var metaDataService in Model.discChangerService.GetAvailableMetaDataServices())
                        {
                            <option>@metaDataService</option>
                        }
                    </select>

                    <div class="form-group">
                        <label for="slots-set" class="col-form-label">For these slots:</label>
                        <input type="text" class="form-control" id="slots-set" disabled>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="metadata-start-retrieval" class="btn btn-primary" data-bs-dismiss="modal">Start metadata retrieval</button>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    @if (dcs.DiscChangers.Count == 0)
    {
        <script>
            toggle_config(document.getElementById('edit'));
        </script>
    }
    <script>
        $(document).ready(function () {
            document.querySelectorAll('[data-bs-toggle="popover"]')
                .forEach(popover => {
                    new bootstrap.Popover(popover, {sanitize:false})
                })
            setup_metadata_dialog($('#metaDataModal'));
        });
        $(document).on("click", ".popover .btn-close", function () {
            $(this).parents(".popover").hide();
        });
    </script>
}
